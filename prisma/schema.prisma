generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Catálogos Fijos)
// ==========================================

enum ModalidadTramite {
  PRESENCIAL
  VIRTUAL
  MIXTA
}

enum EstadoTramite {
  VENTANILLA_INFORMACIONES
  INSCRIPCION_RAPIDA
  PRE_IMPRESION_REVISION
  EN_PROCESO_REGISTRO
  LISTO_PARA_DEVOLUCION
  ENTREGADO
  OBSERVADO
}

enum TipoRequisitoCompraventa {
  TITULO_TRANSFERENCIA
  IMPUESTO_ANUAL_IMPBI
  IMPUESTO_TRANSFERENCIA
  PLANO_Y_CERTIFICADO_CATASTRAL
  CEDULA_IDENTIDAD_O_NIT
  PODER_NOTARIADO
}

enum TipoUbicacion {
  DEPARTAMENTO
  PROVINCIA
  MUNICIPIO
}

enum TipoProfesional {
  ABOGADO_GESTOR
  NOTARIO
  ASESOR_JUNIOR
}

enum MetodoPago {
  QR
  PRESENCIAL
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ==========================================
// CATÁLOGOS MAESTROS
// ==========================================

model Ubicacion {
  id        Int           @id @default(autoincrement())
  nombre    String        @db.VarChar(100)
  tipo      TipoUbicacion
  
  padreId   Int?
  padre     Ubicacion?    @relation("JerarquiaUbicacion", fields: [padreId], references: [id])
  hijos     Ubicacion[]   @relation("JerarquiaUbicacion")
  
  oficinas  Oficina[]
  direcciones Direccion[]

  @@index([padreId])
}

model Institucion {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @db.VarChar(160)
  tramites  Tramite[]
}

model Oficina {
  id             Int       @id @default(autoincrement())
  codigoOficina  String    @unique @db.VarChar(40)
  nombre         String    @db.VarChar(160)
  direccion      String    @db.VarChar(250)
  telefono       String?   @db.VarChar(40)
  latitud        Float?
  longitud       Float?
  
  municipioId    Int
  municipio      Ubicacion @relation(fields: [municipioId], references: [id])
  
  tramites       Tramite[] @relation("TramiteOficinas")
}

model Plan {
  id             Int           @id @default(autoincrement())
  nombre         String        @unique @db.VarChar(80)
  precio         Decimal       @db.Decimal(10, 2)
  esParaProfesional Boolean    @default(false)
  suscripciones  Suscripcion[]
}

// ==========================================
// SEGURIDAD Y USUARIOS (RBAC)
// ==========================================

model Usuario {
  id           Int                  @id @default(autoincrement())
  email        String               @unique @db.VarChar(254)
  passwordHash String               @db.VarChar(255)
  telefono     String?              @db.VarChar(40)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  
  roles        Rol[]                @relation("UsuarioRoles")
  direcciones  Direccion[]
  suscripcion  Suscripcion?
  
  tramitesComoCliente     Tramite[] @relation("TramiteCliente")
  tramitesComoTramitador  Tramite[] @relation("TramiteTramitador")
  compraventas            TramiteCompraventa[]
  perfilProfesional       PerfilProfesional?
  pagosRealizados         Pago[]
  mensajesBitacora        MensajeTramite[]
  auditLogs               AuditLog[]

  @@index([deletedAt])
}

model Rol {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique @db.VarChar(80)
  nombre      String        @db.VarChar(120)
  usuarios    Usuario[]     @relation("UsuarioRoles")
  permisos    RolPermiso[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Permiso {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique @db.VarChar(120)
  descripcion String        @db.VarChar(240)
  roles       RolPermiso[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model RolPermiso {
  rolId     Int
  permisoId Int
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model PerfilProfesional {
  id                Int             @id @default(autoincrement())
  usuarioId         Int             @unique
  usuario           Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  tipo              TipoProfesional
  matricula         String          @db.VarChar(100)
  especialidad      String?         @db.VarChar(200)
  tarifaReferencial Decimal?        @db.Decimal(10, 2)
  
  verificado        Boolean         @default(false)
  destacado         Boolean         @default(false)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Suscripcion {
  id           Int         @id @default(autoincrement())
  usuarioId    Int         @unique
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  planId       Int
  plan         Plan        @relation(fields: [planId], references: [id])
  fechaInicio  DateTime    @default(now())
  fechaFin     DateTime
  activa       Boolean     @default(true)
  deletedAt    DateTime?

  @@index([deletedAt])
}

model Pago {
  id             Int          @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  monto          Decimal      @db.Decimal(10, 2)
  metodo         MetodoPago
  estado         EstadoPago   @default(PENDIENTE)
  comprobanteUrl String?      @db.VarChar(500)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ==========================================
// TRÁMITES (Catálogo)
// ==========================================

model Tramite {
  id                        Int                 @id @default(autoincrement())
  codigo                    Int                 @unique
  codigoOficial             String?             @unique @db.VarChar(20)
  titulo                    String              @db.VarChar(240)
  finalidad                 String              @db.Text
  plazoEntregaDias          Int
  modalidad                 ModalidadTramite
  notaRequisitos            String?             @db.Text
  baseLegal                 String?             @db.Text
  
  videoLsbUrl               String?             @db.VarChar(500)
  audioQuechuaUrl           String?             @db.VarChar(500)
  
  fechaActualizacionOficial DateTime?           
  
  institucionId             Int
  institucion               Institucion         @relation(fields: [institucionId], references: [id])
  
  clienteId                 Int?                
  cliente                   Usuario?            @relation("TramiteCliente", fields: [clienteId], references: [id])
  tramitadorId              Int                 
  tramitador                Usuario             @relation("TramiteTramitador", fields: [tramitadorId], references: [id], onDelete: Cascade)

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  
  requisitos                RequisitoTramite[]
  pasos                     PasoProcedimiento[]
  documentosEntregables     DocumentoEntregable[]
  oficinas                  Oficina[]           @relation("TramiteOficinas")

  @@index([codigo])
  @@index([clienteId])
  @@index([tramitadorId, id])
  @@index([deletedAt])
}

model DocumentoEntregable {
  id        Int     @id @default(autoincrement())
  nombre    String  @db.VarChar(240)
  tramiteId Int
  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@index([tramiteId])
}

model RequisitoTramite {
  id              Int     @id @default(autoincrement())
  nombre          String  @db.VarChar(240)
  detalle         String  @db.Text
  obligatorio     Boolean @default(true)
  orden           Int
  notaCondicional String? @db.Text
  archivoUrl      String? @db.VarChar(500) 
  tramiteId       Int
  tramite         Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@index([tramiteId])
}

model PasoProcedimiento {
  id          Int     @id @default(autoincrement())
  orden       Int
  titulo      String  @db.VarChar(240)
  descripcion String  @db.Text
  plazoDias   Int?
  esGratuito  Boolean @default(true) 
  tramiteId   Int
  tramite     Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@index([tramiteId])
}

// ==========================================
// COMPRAVENTAS (Transaccional)
// ==========================================

model SecuenciaTramiteCompraventa {
  anio   Int @id
  ultimo Int @default(0)
}

model TramiteCompraventa {
  id                     Int                    @id @default(autoincrement())
  codigoTramite          String                 @unique @db.VarChar(32)
  folioReal              String                 @db.VarChar(100)
  fechaIngreso           DateTime               @default(now())
  fechaEstimadaEntrega   DateTime
  fechaEntregaReal       DateTime?
  
  vendedorNombre         String                 @db.VarChar(200)
  vendedorDocumento      String                 @db.VarChar(40)
  compradorNombre        String                 @db.VarChar(200)
  compradorDocumento     String                 @db.VarChar(40)
  esBienGanancial        Boolean                @default(false)
  conApoderado           Boolean                @default(false)
  apoderadoNombre        String?                @db.VarChar(200)
  apoderadoDocumento     String?                @db.VarChar(40)
  numeroPoderNotarial    String?                @db.VarChar(100)
  
  montoArancel           Decimal                @db.Decimal(12, 2)
  arancelPagado          Boolean                @default(false)
  preImpresionConfirmada Boolean                @default(false)
  
  estado                 EstadoTramite          @default(VENTANILLA_INFORMACIONES)
  estadoAnterior         EstadoTramite?
  
  usuarioId              Int
  usuario                Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  
  requisitos             RequisitoCompraventa[]
  bitacora               MensajeTramite[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?

  @@index([usuarioId, estado])
  @@index([fechaIngreso])
  @@index([deletedAt])
}

model RequisitoCompraventa {
  id                 Int                      @id @default(autoincrement())
  tipoRequisito      TipoRequisitoCompraventa
  presentoOriginal   Boolean                  @default(false)
  cantidadFotocopias Int                      @default(0)
  verificado         Boolean                  @default(false)
  archivoUrl         String?                  @db.VarChar(500)
  
  tramiteId          Int
  tramite            TramiteCompraventa       @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@unique([tramiteId, tipoRequisito])
  @@index([tramiteId, verificado])
}

model MensajeTramite {
  id          Int               @id @default(autoincrement())
  tramiteId   Int
  tramite     TramiteCompraventa @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  autorId     Int
  autor       Usuario           @relation(fields: [autorId], references: [id], onDelete: Cascade)
  mensaje     String            @db.Text
  createdAt   DateTime          @default(now())

  @@index([tramiteId])
}

// ==========================================
// DIRECCIONES Y AUDITORÍA
// ==========================================

model Direccion {
  id             Int       @id @default(autoincrement())
  usuarioId      Int?      
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  municipioId    Int
  municipio      Ubicacion @relation(fields: [municipioId], references: [id])
  
  zonaOComunidad String    @db.VarChar(160)
  calleOAvenida  String    @db.VarChar(200)
  numeroPuerta   String?   @db.VarChar(40)
  
  fechaRegistro  DateTime  @default(now())
  deletedAt      DateTime?

  @@index([usuarioId])
  @@index([deletedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String   @db.VarChar(120)
  entityId  String   @db.VarChar(120)
  action    String   @db.VarChar(20)
  userId    Int?
  user      Usuario? @relation(fields: [userId], references: [id], onDelete: SetNull)
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}